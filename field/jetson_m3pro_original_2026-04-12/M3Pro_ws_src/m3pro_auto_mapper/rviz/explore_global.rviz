Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Map1
        - /MapMerged1
        - /PlannedPath1
        - /PlanGoal1
        - /TrackTarget1
        - /GlobalCentroids1
      Splitter Ratio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Alpha: 0.5
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 10
      Cell Size: 1
      Line Style:
        Value: Lines
        Line Width: 0.03
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
      Enabled: true
      Alpha: 0.7
      Use Timestamp: false
      Color Scheme: map
      Draw Behind: false
    - Class: rviz_default_plugins/Map
      Name: MapMerged
      Topic:
        Value: /map_merged
      Enabled: true
      Alpha: 0.8
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
      Enabled: true
      Size (m): 0.05
      Size (Pixels): 3
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Arrows: true
      Show Axes: true
    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Topic:
        Value: /planned_path
      Enabled: true
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/Marker
      Name: PlanGoal
      Topic:
        Value: /plan_goal
      Enabled: true
    - Class: rviz_default_plugins/Marker
      Name: TrackTarget
      Topic:
        Value: /track_target
      Enabled: true
    - Class: rviz_default_plugins/Marker
      Name: StateText
      Topic:
        Value: /auto_explore/state_text
      Enabled: true
    - Class: rviz_default_plugins/Marker
      Name: GlobalCentroids
      Topic:
        Value: /auto_explore/global_centroids
      Enabled: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 2.0
Window Geometry:
  Height: 800
  Width: 1200
  X: 200
  Y: 80
