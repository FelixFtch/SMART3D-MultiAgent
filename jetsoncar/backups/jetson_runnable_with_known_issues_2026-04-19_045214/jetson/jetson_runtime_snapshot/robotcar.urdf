<?xml version="1.0"?>
<robot name="robotcar">
  <link name="base_footprint"/>

  <joint name="footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.350 0.400 0.120"/>
      </geometry>
      <material name="chassis">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.350 0.400 0.120"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.06"/>
    </inertial>
  </link>

  <joint name="lf_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lf_wheel"/>
    <origin xyz="0.175 0.200 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="lf_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.050" length="0.040"/>
      </geometry>
      <material name="blk">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="rf_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rf_wheel"/>
    <origin xyz="0.175 -0.200 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rf_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.050" length="0.040"/>
      </geometry>
      <material name="blk"/>
    </visual>
  </link>

  <joint name="lr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="lr_wheel"/>
    <origin xyz="-0.175 0.200 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="lr_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.050" length="0.040"/>
      </geometry>
      <material name="blk"/>
    </visual>
  </link>

  <joint name="rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rr_wheel"/>
    <origin xyz="-0.175 -0.200 -0.01" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rr_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.050" length="0.040"/>
      </geometry>
      <material name="blk"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.050" rpy="0 0 0"/>
  </joint>
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.4 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
</robot>
